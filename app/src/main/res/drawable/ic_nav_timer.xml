<?xml version="1.0" encoding="utf-8"?>
<!-- Stopwatch. Outline style, 24dp grid, 1.75dp stroke, round caps — the same
     spec as the other three navigation icons, so the bar reads as one set.
     Colour here is irrelevant: the Icon composable tints the whole path. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.75"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M9,3 h6 M12,3 v3 M5,13 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 M12,9.5 v3.8 l2.6,2.6" />
</vector>
